[Unit]
Description=Facebook through partner access: match shared Pages to customers (partner-sync.js)
[Service]
UMask=0027
Type=oneshot
WorkingDirectory=/home/monitor/abaitzik-monitor
EnvironmentFile=/etc/monitor.env
ExecStart=/usr/bin/node partner-sync.js
StandardOutput=append:/var/log/monitor-partner.log
StandardError=append:/var/log/monitor-partner.log
